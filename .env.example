NODE_ENV=development
PORT=5000
HOST=0.0.0.0
API_PREFIX=/api/v1
APP_NAME=MMP API
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mmp?schema=public
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
SHUTDOWN_TIMEOUT_MS=10000
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
REDIS_URL=redis://localhost:6379
OTP_EXPIRES_IN_SECONDS=300
OTP_MAX_ATTEMPTS=3
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Mouza Map Pro <no-reply@example.com>

# Admin seed credentials (used on server start if no admin exists)
ADMIN_EMAIL=admin@mouzamappro.com
ADMIN_NAME=System Admin
ADMIN_PASSWORD=11111111

# Surveyor seed credentials (used on server start if no surveyor exists)
SURVEYOR_EMAIL=surveyor@mouzamappro.com
SURVEYOR_NAME=Demo Surveyor
SURVEYOR_PASSWORD=11111111
