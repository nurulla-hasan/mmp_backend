# Application environment (development | production | test)
NODE_ENV=development
# Port the server listens on
PORT=5000
# Host address to bind the server (0.0.0.0 = all interfaces)
HOST=0.0.0.0
# Prefix for all API routes
API_PREFIX=/api/v1
# Display name for the application
APP_NAME=MMP API
# PostgreSQL connection string (Prisma)
DATABASE_URL=
# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000
# Trust reverse proxy headers (set true behind Nginx)
TRUST_PROXY=false
# Rate-limit window in milliseconds (15 min)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window per IP
RATE_LIMIT_MAX=100
# Graceful shutdown timeout in milliseconds
SHUTDOWN_TIMEOUT_MS=10000

# Secret key for signing JWT access tokens (min 32 characters)
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
# Access token expiry duration
JWT_ACCESS_EXPIRES_IN=15m
# Secret key for signing JWT refresh tokens (min 32 characters)
JWT_REFRESH_SECRET=replace-with-at-least-32-characters
# Refresh token expiry duration
JWT_REFRESH_EXPIRES_IN=7d