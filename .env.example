NODE_ENV=development
PORT=5000
HOST=0.0.0.0
API_PREFIX=/api/v1
APP_NAME=MMP API
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mmp?schema=public
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
SHUTDOWN_TIMEOUT_MS=10000

JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=mmp-api
JWT_AUDIENCE=mmp-client
