model SurveyorService {
  id                String          @id @default(uuid())
  surveyorProfileId String          @map("surveyor_profile_id")
  serviceId         String          @map("service_id")
  startingPrice     Float           @map("starting_price")

  surveyorProfile SurveyorProfile @relation(fields: [surveyorProfileId], references: [id], onDelete: Cascade)
  service         Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([surveyorProfileId, serviceId])
  @@index([serviceId])
  @@map("surveyor_services")
}
