model SurveyorReview {
  id                String            @id @default(uuid())
  surveyorProfileId String            @map("surveyor_profile_id")
  reviewerName      String            @map("reviewer_name")
  rating            Int
  comment           String
  status            VerificationStatus @default(PENDING)
  createdAt         DateTime          @default(now()) @map("created_at")

  surveyorProfile SurveyorProfile @relation(fields: [surveyorProfileId], references: [id], onDelete: Cascade)

  @@index([surveyorProfileId])
  @@map("surveyor_reviews")
}
