{
  "info": {
    "_postman_id": "mmp-backend-api-collection",
    "name": "Mouza Map Pro (MMP) - API Collection",
    "description": "Complete and comprehensive Postman collection for Mouza Map Pro (MMP) backend APIs, including Auth, Services catalog, Districts & Upazilas, Surveyor directory, Surveyor profile, and standalone Surveyor services.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Authentication & Profile",
      "description": "User registration, OTP email verification, login, JWT token refresh, and user profile management.",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Md. Abdul Karim\",\n  \"email\": \"abdul.karim@example.com\",\n  \"password\": \"Password123@\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Register a new user account. Sends a 6-digit OTP code to the provided email address for verification."
          }
        },
        {
          "name": "Verify Email (OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"abdul.karim@example.com\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/verify-email",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "verify-email"]
            },
            "description": "Verify user email address using the 6-digit OTP received via email. Returns access and refresh tokens upon success."
          }
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"abdul.karim@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/resend-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "resend-otp"]
            },
            "description": "Resends a new 6-digit OTP to the registered unverified email address."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"abdul.karim@example.com\",\n  \"password\": \"Password123@\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Login with email and password. Returns user object, accessToken and refreshToken, and sets auth cookies."
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh-token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh-token"]
            },
            "description": "Generates a new accessToken using the refreshToken from body or cookies."
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "Get current logged-in user profile, roles, primary location, and associated surveyor profile (if any)."
          }
        },
        {
          "name": "Update Current User (Me)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"মো. আব্দুল করিম\",\n  \"phone\": \"01712345678\",\n  \"whatsappNumber\": \"01712345678\",\n  \"district\": \"dinajpur\",\n  \"upazila\": \"দিনাজপুর সদর\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "Update personal information and primary location of current logged-in user. All fields are optional."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Logs out current user and clears authentication cookies."
          }
        }
      ]
    },
    {
      "name": "02. Services (Catalog)",
      "description": "Master catalog of land survey services offered on Mouza Map Pro (e.g. Land Measurement, Mouza Map Studio, Boundary Determination).",
      "item": [
        {
          "name": "Get All Services (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/services",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "services"]
            },
            "description": "Public endpoint to retrieve the list of all available services."
          }
        },
        {
          "name": "Get Service by Slug (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/services/:slug",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "services", ":slug"],
              "variable": [
                {
                  "key": "slug",
                  "value": "land-measurement",
                  "description": "Service slug"
                }
              ]
            },
            "description": "Public endpoint to retrieve single service details by its unique slug."
          }
        },
        {
          "name": "Create Service (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"digital-survey\",\n  \"name\": \"ডিজিটাল সার্ভে ও নকশা\",\n  \"description\": \"আধুনিক ডিজিটাল টোটাল স্টেশন ও জিপিএস দিয়ে নির্ভুল ডিজিটাল জরিপ সেবা।\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/services",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "services"]
            },
            "description": "Admin only endpoint to add a new service to the catalog."
          }
        },
        {
          "name": "Update Service (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"ডিজিটাল সার্ভে ও ড্রয়িং\",\n  \"description\": \"আধুনিক টোটাল স্টেশন দিয়ে জমির নির্ভুল সীমানা ও প্লট ড্রয়িং।\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/services/:slug",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "services", ":slug"],
              "variable": [
                {
                  "key": "slug",
                  "value": "digital-survey",
                  "description": "Service slug to update"
                }
              ]
            },
            "description": "Admin only endpoint to update an existing service by its slug."
          }
        },
        {
          "name": "Delete Service (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/services/:slug",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "services", ":slug"],
              "variable": [
                {
                  "key": "slug",
                  "value": "digital-survey",
                  "description": "Service slug to delete"
                }
              ]
            },
            "description": "Admin only endpoint to remove a service from the catalog."
          }
        }
      ]
    },
    {
      "name": "03. Districts & Upazilas",
      "description": "Location hierarchy catalog containing districts and their nested upazilas across Bangladesh.",
      "item": [
        {
          "name": "Get All Districts with Upazilas (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/districts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "districts"]
            },
            "description": "Public catalog returning all districts with their label, slug value, and list of upazila names."
          }
        },
        {
          "name": "Create District (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"দিনাজপুর\",\n  \"slug\": \"dinajpur\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/districts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "districts"]
            },
            "description": "Admin only endpoint to add a new district."
          }
        },
        {
          "name": "Update District (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"দিনাজপুর\",\n  \"slug\": \"dinajpur\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/districts/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "districts", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "district-uuid-here",
                  "description": "District ID"
                }
              ]
            },
            "description": "Admin only endpoint to update district name or slug."
          }
        },
        {
          "name": "Delete District (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/districts/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "districts", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "district-uuid-here",
                  "description": "District ID"
                }
              ]
            },
            "description": "Admin only endpoint to delete a district."
          }
        },
        {
          "name": "Create Upazila (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"দিনাজপুর সদর\",\n  \"slug\": \"dinajpur-sadar\",\n  \"districtId\": \"district-uuid-here\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/districts/upazilas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "districts", "upazilas"]
            },
            "description": "Admin only endpoint to add an upazila under a district."
          }
        },
        {
          "name": "Update Upazila (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"বীরগঞ্জ\",\n  \"slug\": \"birganj\",\n  \"districtId\": \"district-uuid-here\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/districts/upazilas/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "districts", "upazilas", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "upazila-uuid-here",
                  "description": "Upazila ID"
                }
              ]
            },
            "description": "Admin only endpoint to update an upazila."
          }
        },
        {
          "name": "Delete Upazila (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/districts/upazilas/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "districts", "upazilas", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "upazila-uuid-here",
                  "description": "Upazila ID"
                }
              ]
            },
            "description": "Admin only endpoint to delete an upazila."
          }
        }
      ]
    },
    {
      "name": "04. Surveyor Directory & Profiles",
      "description": "Public surveyor listing, detailed public profiles, application as a surveyor, self-profile updates, and admin verification.",
      "item": [
        {
          "name": "Get All Verified Surveyors (Public with Filters & Pagination)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/surveyor?searchTerm=দিনাজপুর&district=dinajpur&service=land-measurement&rating=4&sortBy=rating_desc&page=1&limit=12",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "surveyor"],
              "query": [
                {
                  "key": "searchTerm",
                  "value": "দিনাজপুর",
                  "description": "Search by surveyor name, headline, bio, location or service name"
                },
                {
                  "key": "district",
                  "value": "dinajpur",
                  "description": "Filter by coverage district slug"
                },
                {
                  "key": "service",
                  "value": "land-measurement",
                  "description": "Filter by offered service slug"
                },
                {
                  "key": "rating",
                  "value": "4",
                  "description": "Filter by minimum rating (e.g. 4 for 4+ stars)"
                },
                {
                  "key": "experienceMin",
                  "value": "2",
                  "disabled": true,
                  "description": "Minimum years of experience"
                },
                {
                  "key": "experienceMax",
                  "value": "20",
                  "disabled": true,
                  "description": "Maximum years of experience"
                },
                {
                  "key": "sortBy",
                  "value": "rating_desc",
                  "description": "Sort order: rating_desc | experience_desc | newest | oldest"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (defaults to 1)"
                },
                {
                  "key": "limit",
                  "value": "12",
                  "description": "Items per page (defaults to 12, max 50)"
                }
              ]
            },
            "description": "Public listing endpoint returning verified surveyors with pagination meta (page, limit, total, totalPages) and full nested service & area data."
          }
        },
        {
          "name": "Get Single Surveyor by Slug (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/surveyor/:slug",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "surveyor", ":slug"],
              "variable": [
                {
                  "key": "slug",
                  "value": "demo-surveyor",
                  "description": "Unique slug of the surveyor"
                }
              ]
            },
            "description": "Public endpoint to retrieve complete public profile of a surveyor including user information, services with starting prices, service areas, and approved reviews."
          }
        },
        {
          "name": "Get My Surveyor Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/surveyor/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "surveyor", "profile"]
            },
            "description": "Retrieve logged-in surveyor's own profile data (Surveyor role required)."
          }
        },
        {
          "name": "Apply as Surveyor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"headline\": \"জমি পরিমাপ ও ডিজিটাল সার্ভে বিশেষজ্ঞ\",\n  \"bio\": \"আমি দীর্ঘ ১০ বছর ধরে দিনাজপুর ও পার্শ্ববর্তী এলাকায় বিশ্বস্ততার সাথে জমি জরিপ, প্লট ড্রয়িং এবং খতিয়ান সংক্রান্ত কাজ করে আসছি।\",\n  \"experienceYears\": 10,\n  \"serviceAreas\": [\n    {\n      \"district\": \"dinajpur\",\n      \"upazilas\": [\"দিনাজপুর সদর\", \"বিরল\", \"কাহারোল\"]\n    },\n    {\n      \"district\": \"thakurgaon\",\n      \"upazilas\": [\"ঠাকুরগাঁও সদর\"]\n    }\n  ],\n  \"services\": [\n    {\n      \"serviceId\": \"service-uuid-1\",\n      \"startingPrice\": 3500\n    },\n    {\n      \"serviceId\": \"service-uuid-2\",\n      \"startingPrice\": 5000\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/surveyor/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "surveyor", "profile"]
            },
            "description": "Submit an application to register as a professional surveyor. Creates profile in PENDING verification status."
          }
        },
        {
          "name": "Update My Surveyor Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"headline\": \"জমি পরিমাপ, সীমানা নির্ধারণ ও ডিজিটাল সার্ভে বিশেষজ্ঞ\",\n  \"experienceYears\": 11,\n  \"bio\": \"আমি দীর্ঘ ১১ বছর ধরে বিশ্বস্ততার সাথে জমি জরিপ, সীমানা চিহ্নিতকরণ ও ডিজিটাল নকশার কাজ করে আসছি।\",\n  \"serviceAreas\": [\n    {\n      \"district\": \"dinajpur\",\n      \"upazilas\": [\"দিনাজপুর সদর\", \"বিরল\", \"বোচাগঞ্জ\", \"কাহারোল\"]\n    }\n  ],\n  \"services\": [\n    {\n      \"serviceId\": \"service-uuid-1\",\n      \"startingPrice\": 4000\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/surveyor/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "surveyor", "profile"]
            },
            "description": "Update logged-in surveyor profile fields (headline, bio, experienceYears, serviceAreas, services). All fields are optional."
          }
        },
        {
          "name": "Verify / Approve Surveyor (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\",\n  \"adminNote\": \"এনআইডি এবং পেশাগত সনদ যাচাই সম্পন্ন হয়েছে।\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/surveyor/:userId/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "surveyor", ":userId", "verify"],
              "variable": [
                {
                  "key": "userId",
                  "value": "target-user-uuid-here",
                  "description": "User ID of the applicant surveyor"
                }
              ]
            },
            "description": "Admin only endpoint to approve or reject a surveyor's application. When approved, user role is upgraded to SURVEYOR."
          }
        }
      ]
    },
    {
      "name": "05. Surveyor Standalone Services",
      "description": "Endpoints for a surveyor to manage their individual services and starting prices outside the full profile update.",
      "item": [
        {
